    {
      "name": "4. POST /todos - happy path (self-cleaning)",
      "item": [
        {
          "name": "POST /todos - create valid todo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"QA Newman test todo\", \"description\": \"created by automated test\", \"status\": \"In Planung\", \"author\": \"qa.newman@example.com\", \"road_fid\": 1306}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location header points to new resource\", () => pm.expect(pm.response.headers.has(\"Location\")).to.be.true);",
                  "const b = pm.response.json();",
                  "pm.test(\"server assigned a numeric id\", () => pm.expect(b.id).to.be.a(\"number\"));",
                  "pm.test(\"echoes posted fields\", () => {",
                  "    pm.expect(b.title).to.eql(\"QA Newman test todo\");",
                  "    pm.expect(b.road_fid).to.eql(1306);",
                  "});",
                  "pm.collectionVariables.set(\"createdTodoId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET created todo - verify persisted",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos/{{createdTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"persisted with correct id and title\", () => {",
                  "    pm.expect(b.id).to.eql(pm.collectionVariables.get(\"createdTodoId\"));",
                  "    pm.expect(b.title).to.eql(\"QA Newman test todo\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE created todo - cleanup",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/todos/{{createdTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET deleted todo -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos/{{createdTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404 after deletion\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. POST /todos - negative & edge cases",
      "item": [
        {
          "name": "[DEFECT #2] POST empty body {} -> 400 expected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// DEFECT #2: no input validation. A todo without title and road_fid must be rejected",
                  "// with 400. Actual: 201 + record with only an id -> this test fails on purpose.",
                  "pm.test(\"[DEFECT #2] empty todo (no title/road_fid) is rejected with 400\", () => pm.response.to.have.status(400));",
                  "// self-cleaning: the server still creates a record while the defect exists -> delete it",
                  "if (pm.response.code === 201) {",
                  "    pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/todos/\") + pm.response.json().id, method: \"DELETE\" }, (err, res) => {",
                  "        pm.test(\"cleanup: empty todo deleted again\", () => { pm.expect(err).to.be.null; pm.expect(res.code).to.eql(200); });",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "[DEFECT #2] POST empty title \"\" -> 400 expected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"\", \"status\": \"open\", \"road_fid\": 1306}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// DEFECT #2: no input validation. An empty title is no title - the todo must be rejected",
                  "// with 400. Actual: 201 -> this test fails on purpose.",
                  "pm.test(\"[DEFECT #2] todo with an empty title is rejected with 400\", () => pm.response.to.have.status(400));",
                  "// self-cleaning: the server still creates a record while the defect exists -> delete it",
                  "if (pm.response.code === 201) {",
                  "    pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/todos/\") + pm.response.json().id, method: \"DELETE\" }, (err, res) => {",
                  "        pm.test(\"cleanup: empty-title todo deleted again\", () => { pm.expect(err).to.be.null; pm.expect(res.code).to.eql(200); });",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "[DEFECT #2] POST road_fid as string -> 400 expected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"road_fid sent as a string\", \"status\": \"open\", \"road_fid\": \"abc\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// DEFECT #2: no type check. road_fid references a road and must be an integer - a string",
                  "// must be rejected with 400. Actual: 201 -> this test fails on purpose.",
                  "pm.test(\"[DEFECT #2] todo with a non-integer road_fid is rejected with 400\", () => pm.response.to.have.status(400));",
                  "// self-cleaning: the server still creates a record while the defect exists -> delete it",
                  "if (pm.response.code === 201) {",
                  "    pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/todos/\") + pm.response.json().id, method: \"DELETE\" }, (err, res) => {",
                  "        pm.test(\"cleanup: string-road_fid todo deleted again\", () => { pm.expect(err).to.be.null; pm.expect(res.code).to.eql(200); });",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "[DEFECT #2] POST unknown road_fid 999999 -> 400/422 expected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"todo for a road that does not exist\", \"status\": \"open\", \"road_fid\": 999999}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// DEFECT #2: no reference check. There is no road with fid 999999, so the todo would point",
                  "// nowhere - expected 400 or 422. Actual: 201 -> this test fails on purpose.",
                  "pm.test(\"[DEFECT #2] todo for a road that does not exist is rejected with 400 or 422\", () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));",
                  "// self-cleaning: the server still creates a record while the defect exists -> delete it",
                  "if (pm.response.code === 201) {",
                  "    pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/todos/\") + pm.response.json().id, method: \"DELETE\" }, (err, res) => {",
                  "        pm.test(\"cleanup: unknown-road todo deleted again\", () => { pm.expect(err).to.be.null; pm.expect(res.code).to.eql(200); });",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "[DEFECT #5] POST duplicate id (id:1) -> 409 expected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"id\": 1, \"title\": \"duplicate id attempt\", \"road_fid\": 1306}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
