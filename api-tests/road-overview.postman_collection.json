{
  "info": {
    "name": "Road Overview API - json-server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API test collection for the Road Overview json-server backend (base http://localhost:3000). Covers GET /roads, GET/POST /todos plus json-server features (filtering, sorting, pagination, single records) and negative/edge cases. All state-changing tests are self-cleaning (created todos are deleted again), so the collection is idempotent.\n\nNOT executed here (destructive, not recoverable via API): POST /roads returns 201 and OVERWRITES the entire FeatureCollection. See README for the documented reproduction. Assertions were verified empirically against json-server@0.17.4."
  },
  "item": [
    {
      "name": "1. GET /roads",
      "item": [
        {
          "name": "GET /roads - happy path",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/roads"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const b = pm.response.json();",
                  "pm.test(\"body is a GeoJSON FeatureCollection\", () => pm.expect(b.type).to.eql(\"FeatureCollection\"));",
                  "pm.test(\"features is a non-empty array\", () => { pm.expect(b.features).to.be.an(\"array\"); pm.expect(b.features.length).to.be.above(0); });",
                  "pm.test(\"seed contains 773 road features (regression guard)\", () => pm.expect(b.features.length).to.eql(773));",
                  "pm.test(\"a feature has properties.fid (number) and eemi_grade (object)\", () => {",
                  "    const p = b.features[0].properties;",
                  "    pm.expect(p.fid).to.be.a(\"number\");",
                  "    pm.expect(p.eemi_grade).to.be.an(\"object\");",
                  "});",
                  "pm.test(\"response under 3s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /roads?_page&_limit&_sort - params ignored (limitation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/roads?_page=1&_limit=5&_sort=fid"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// /roads value is an OBJECT (FeatureCollection), not an array -> json-server",
                  "// pagination/sorting/filtering do NOT apply. This documents that limitation.",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"pagination ignored: full FeatureCollection still returned\", () => pm.expect(b.features.length).to.eql(773));",
                  "pm.test(\"no X-Total-Count header (not a paginable array resource)\", () => pm.expect(pm.response.headers.has(\"X-Total-Count\")).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /roads/1306 -> 404 (object resource, no id lookup)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/roads/1306"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"body is empty object\", () => pm.expect(pm.response.json()).to.eql({}));"
                ]
              }
            }
          ]
        }
      ]
    },
