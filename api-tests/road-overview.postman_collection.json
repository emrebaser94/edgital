    {
      "name": "4. POST /todos - happy path (self-cleaning)",
      "item": [
        {
          "name": "POST /todos - create valid todo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"QA Newman test todo\", \"description\": \"created by automated test\", \"status\": \"In Planung\", \"author\": \"qa.newman@example.com\", \"road_fid\": 1306}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location header points to new resource\", () => pm.expect(pm.response.headers.has(\"Location\")).to.be.true);",
                  "const b = pm.response.json();",
                  "pm.test(\"server assigned a numeric id\", () => pm.expect(b.id).to.be.a(\"number\"));",
                  "pm.test(\"echoes posted fields\", () => {",
                  "    pm.expect(b.title).to.eql(\"QA Newman test todo\");",
                  "    pm.expect(b.road_fid).to.eql(1306);",
                  "});",
                  "pm.collectionVariables.set(\"createdTodoId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET created todo - verify persisted",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos/{{createdTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"persisted with correct id and title\", () => {",
                  "    pm.expect(b.id).to.eql(pm.collectionVariables.get(\"createdTodoId\"));",
                  "    pm.expect(b.title).to.eql(\"QA Newman test todo\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE created todo - cleanup",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/todos/{{createdTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET deleted todo -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos/{{createdTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404 after deletion\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. POST /todos - negative & edge cases",
      "item": [
        {
          "name": "POST empty body {} - accepted, NO validation (FINDING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// FINDING: json-server performs no schema validation. An empty todo (no title,",
                  "// no road_fid) is accepted with 201. A real API should reject with 400.",
                  "pm.test(\"status is 201 (documents missing validation)\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"record created with only an id\", () => pm.expect(b.id).to.be.a(\"number\"));",
                  "pm.test(\"FINDING: mandatory fields (title/road_fid) NOT enforced\", () => {",
                  "    pm.expect(b).to.not.have.property(\"title\");",
                  "    pm.expect(b).to.not.have.property(\"road_fid\");",
                  "});",
                  "pm.collectionVariables.set(\"emptyTodoId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cleanup empty todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/todos/{{emptyTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"cleanup deletes empty todo (200)\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST duplicate id (id:1) -> 500",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"id\": 1, \"title\": \"duplicate id attempt\", \"road_fid\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 500 for duplicate id\", () => pm.response.to.have.status(500));",
                  "pm.test(\"error mentions duplicate id\", () => pm.expect(pm.response.text().toLowerCase()).to.include(\"duplicate id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST malformed JSON -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{ this is not valid json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400 for malformed JSON body\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST wrong Content-Type (text/plain) - body dropped (FINDING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": "{{baseUrl}}/todos",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"sent as text/plain\", \"road_fid\": 42}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// FINDING: with a non-JSON Content-Type the body is silently ignored; the",
                  "// record is created empty (only an id) instead of returning 415/400.",
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"FINDING: payload silently dropped, no title stored\", () => pm.expect(b).to.not.have.property(\"title\"));",
                  "pm.collectionVariables.set(\"textTodoId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cleanup text/plain todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/todos/{{textTodoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"cleanup deletes text/plain todo (200)\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
