                  "pm.test(\"[DEFECT #3] non-JSON Content-Type is rejected with 415 (or 400)\", () => pm.expect(pm.response.code).to.be.oneOf([415, 400]));",
                  "// self-cleaning: the server still creates a record while the defect exists -> delete it",
                  "if (pm.response.code === 201) {",
                  "    pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/todos/\") + pm.response.json().id, method: \"DELETE\" }, (err, res) => {",
                  "        pm.test(\"cleanup: text/plain todo deleted again\", () => { pm.expect(err).to.be.null; pm.expect(res.code).to.eql(200); });",
