          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const total = parseInt(pm.response.headers.get(\"X-Total-Count\"));",
                  "pm.test(\"page holds at most _limit=2 items\", () => pm.expect(b.length).to.be.at.most(2));",
                  "pm.test(\"page size honours limit vs total\", () => pm.expect(b.length).to.eql(Math.min(2, total)));",
                  "pm.test(\"X-Total-Count header present and consistent\", () => {",
